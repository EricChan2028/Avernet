  ],
  "obligations": [
    {
      "id": "tc-friend-auth-sync.ensure",
      "method": "POST",
      "path": "/admin/bots/{bot_uuid}/ensure",
      "expectation": "Ensure the protected TC-shaped bot id 2026e2e-tc-bot:85020 under X-BCS-Service-Key and require 200.",
      "failure_codes": [
        "ENSURE_STATUS_MISMATCH"
      ]
    },
    {
      "id": "tc-friend-auth-sync.create",
      "method": "POST",
      "path": "/collaboration/friend-connections/requests",
      "expectation": "Forward the iss=backend approver principal on create and require exactly one pending row.",
      "failure_codes": [
        "CREATE_STATUS_MISMATCH",
        "PENDING_ROW_MISSING"
      ]
    },
    {
      "id": "tc-friend-auth-sync.accept",
      "method": "POST",
      "path": "/collaboration/friend-connections/requests/{request_id}/accept",
      "expectation": "Accept the pending row with the same forwarded principal and require a built edge.",
      "failure_codes": [
        "ACCEPT_STATUS_MISMATCH",
        "EDGE_NOT_BUILT"
      ]
    },
    {
      "id": "tc-friend-auth-sync.observe-sync",
      "method": "GET",
      "path": "/control/friend-auth-sync/requests",
      "expectation": "Observe exactly one grant sync with the TC identity and the approver re-addressed as iss=bcs/aud=backend.",
      "failure_codes": [
        "SYNC_CALL_COUNT_MISMATCH",
        "SYNC_BODY_MISMATCH",
        "SYNC_PRINCIPAL_UNDECODABLE",
        "SYNC_PRINCIPAL_MISMATCH"
      ]
    },
    {
      "id": "tc-friend-auth-sync.local-receipt",
      "method": "MODEL",
      "path": "owned-local-transcript",
      "expectation": "Validate the complete owned-local transcript shape before judging any obligation.",
      "failure_codes": [
        "TRANSCRIPT_INVALID"
      ]
    }
  ],
  "failure_semantics": [
    {
      "code": "TRANSCRIPT_INVALID",
      "stage": "local-receipt",
      "expected": "one owned-local transcript with ensure/create/accept/sync fields",
      "observed_if_mismatch": "missing, extra or non-object transcript fields"
    },
    {
      "code": "ENSURE_STATUS_MISMATCH",
      "stage": "ensure-tc-bot",
      "expected": "HTTP 200 from the service-key ensure route",
      "observed_if_mismatch": "non-200 ensure response or transport failure"
    },
    {
      "code": "CREATE_STATUS_MISMATCH",
      "stage": "create-forwarded-request",
      "expected": "HTTP 200 from the owned-local legacy friend request route",
      "observed_if_mismatch": "non-200 create response on the selected profile"
    },
    {
      "code": "PENDING_ROW_MISSING",
      "stage": "create-forwarded-request",
      "expected": "exactly one pending request id for the TC bot",
      "observed_if_mismatch": "missing request_ids, non-pending status or wrong row count"
    },
    {
      "code": "ACCEPT_STATUS_MISMATCH",
      "stage": "accept-forwarded-request",
      "expected": "HTTP 200 from the owned-local legacy accept route",
      "observed_if_mismatch": "non-200 accept response on the selected profile"
    },
    {
      "code": "EDGE_NOT_BUILT",
      "stage": "accept-forwarded-request",
      "expected": "at least one non-empty edge id after accept",
      "observed_if_mismatch": "empty or malformed edge_ids"
    },
    {
      "code": "SYNC_CALL_COUNT_MISMATCH",
      "stage": "observe-readdressed-sync",
      "expected": "exactly one friend-auth-sync call",
      "observed_if_mismatch": "zero, multiple or malformed sync records"
    },
    {
      "code": "SYNC_BODY_MISMATCH",
      "stage": "observe-readdressed-sync",
      "expected": "bot_id=2026e2e-tc-bot, owner_work_no=85020, action=grant",
      "observed_if_mismatch": "missing or different sync body fields"
    },
    {
      "code": "SYNC_PRINCIPAL_UNDECODABLE",
      "stage": "observe-readdressed-sync",
      "expected": "a three-segment decodable principal JWT",
      "observed_if_mismatch": "missing or malformed principal token"
    },
    {
      "code": "SYNC_PRINCIPAL_MISMATCH",
      "stage": "observe-readdressed-sync",
      "expected": "iss=bcs, aud=backend and approver subject id 153998",
      "observed_if_mismatch": "different issuer, audience or approver subject"
    }
  ],
  "expected_values": {
    "tc_bot": "2026e2e-tc-bot:85020",
